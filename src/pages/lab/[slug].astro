---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { formatMonthYear, getLabEntries, statusLabel } from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getLabEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, summary, status, date, tags, link, cover, coverAlt } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="page-header container">
      <a class="back label" href="/lab">← The lab</a>
      <p class="label kicker">{statusLabel[status]} · Since {formatMonthYear(date)}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      {
        (tags.length > 0 || link) && (
          <div class="meta">
            {tags.map((t) => (
              <Tag>{t}</Tag>
            ))}
            {link && (
              <a href={link} target="_blank" rel="noopener">
                Visit project ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      cover && (
        <div class="container">
          <Image
            class="cover"
            src={cover}
            alt={coverAlt ?? ''}
            widths={[800, 1400, 2000]}
            sizes="(max-width: 76rem) 100vw, 72rem"
            loading="eager"
          />
        </div>
      )
    }

    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    text-decoration: none;
    margin-bottom: var(--space-l);
  }

  .back:hover {
    color: var(--accent);
  }

  .kicker {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  .meta a {
    margin-left: var(--space-s);
    color: var(--accent);
  }

  .cover {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: var(--space-xl);
  }
</style>
