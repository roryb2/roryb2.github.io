---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel, projectWhen } from '../lib/content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, category } = project.data;
const number = String(index + 1).padStart(2, '0');
---

<li class="row" data-category={category}>
  <a href={`/work/${project.id}`}>
    <span class="num label" aria-hidden="true">{number}</span>
    <span class="main">
      <span class="title">{title}</span>
      <span class="summary">{summary}</span>
    </span>
    <span class="meta">
      <span class="label">{categoryLabel[category]}</span>
      <span class="label year">{projectWhen(project.data)}</span>
    </span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .row {
    border-top: 1px solid var(--rule);
  }

  .row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  a {
    display: grid;
    grid-template-columns: 3rem 1fr auto 1.5rem;
    align-items: baseline;
    gap: var(--space-m);
    padding-block: var(--space-l);
    text-decoration: none;
    transition: padding 0.35s var(--ease);
  }

  .title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    transition: color 0.2s var(--ease);
  }

  .summary {
    display: block;
    margin-top: var(--space-xs);
    color: var(--ink-muted);
    max-width: 44ch;
    font-size: 0.97rem;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2xs);
    text-align: right;
  }

  .num {
    color: var(--accent);
  }

  .arrow {
    font-size: var(--step-1);
    color: var(--ink-muted);
    transition:
      transform 0.35s var(--ease),
      color 0.2s var(--ease);
  }

  a:hover {
    color: var(--ink);
    padding-left: var(--space-s);
  }

  a:hover .title,
  a:hover .arrow {
    color: var(--accent);
  }

  a:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 48rem) {
    a {
      grid-template-columns: 2.25rem 1fr;
      gap: var(--space-xs) var(--space-s);
      padding-block: var(--space-m);
    }

    .meta {
      grid-column: 2;
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-s);
      text-align: left;
    }

    .arrow {
      display: none;
    }

    a:hover {
      padding-left: 0;
    }
  }
</style>
