---
// Headline numbers for a case study. Use inside MDX:
// <Stats items={[{ value: '45+', label: 'automated data tests' }]} />
interface Props {
  items: { value: string; label: string }[];
}

const { items } = Astro.props;
---

<dl class="stats">
  {
    items.map((item) => (
      <div class="stat">
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-m);
    margin-block: var(--space-l);
    padding-block: var(--space-m);
    border-block: 1px solid var(--rule);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2xs);
  }

  dd {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
    color: var(--accent);
    font-variant-numeric: lining-nums;
  }

  dt {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.4;
  }
</style>
